# Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY api/AzureStay.Api/AzureStay.Api.csproj api/AzureStay.Api/
RUN dotnet restore api/AzureStay.Api/AzureStay.Api.csproj
COPY api/ api/
RUN dotnet publish api/AzureStay.Api/AzureStay.Api.csproj -c Release -o /app /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "AzureStay.Api.dll"]
